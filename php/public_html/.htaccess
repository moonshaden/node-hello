# Send every request that is not a real file to the front controller.
RewriteEngine On

# Canonical host and HTTPS. Uncomment once the certificate is issued.
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Old WordPress URLs. These ran for years — keep them working.
#
# The targets MUST be root-relative ('/faq', not 'faq'). In a .htaccess an
# external redirect with a relative substitution is resolved against the
# FILESYSTEM directory, not the URL space, so 'faq' became
# https://host/home/<account>/public_html/faq -- a dead link that also leaked
# the server path. Caught on the build subdomain; it cannot reproduce in either
# dev build, since neither reads this file.
RewriteRule ^available-scholarships/?$ /scholarships [R=301,L]
RewriteRule ^scholarship-recipients/?$ /recipients [R=301,L]
RewriteRule ^scholarship-faqs/?$ /faq [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

# Static assets are safe to cache; the HTML is generated per request and
# carries no Last-Modified, so it is never cached and always re-fetched -- which
# is what makes the versioned asset URLs below work.
#
# mod_expires is NOT enabled on this host: these rules were in place and the
# server still answered with no Cache-Control at all, which is how a returning
# visitor ended up holding a stale stylesheet for days after a deploy. They are
# kept for a host that does have it, and mod_headers (which IS enabled here)
# states the same intent below.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
  # The stylesheet and the script are requested with a hash of their own bytes
  # in the query string, so a changed file is a different URL and a year is
  # safe: nothing can serve a stale one.
  <FilesMatch "\.(css|js)$">
    Header always set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # Images are NOT versioned -- their URLs are plain /img/... paths -- so they
  # get a week. Long enough to matter, short enough that a replaced portrait
  # reaches a returning visitor without anyone clearing a cache.
  <FilesMatch "\.(jpg|jpeg|png|ico|svg|webp)$">
    Header always set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Nothing here should ever be listed.
Options -Indexes
