<%- include('partials/head', { description: page.summary }) %>

<div class="page-head">
  <div class="wrap">
    <h1><%= page.title %></h1>
    <% if (page.summary) { %><p class="lede"><%= page.summary %></p><% } %>
  </div>
</div>

<%
  // Past this many questions a single prose column reads as a wall, so the page
  // gets a jump-to index and every heading an anchor. Mirrored in page.php.
  const INDEX_FROM = 6;
  const article = markdown.renderSections(page.body);
  const index = article.headings.length >= INDEX_FROM ? article.headings : [];
%>
<%
  // A page can close its copy with a photograph that ends level with the bottom
  // of the aside card. The two have to END together, and a float's bottom is not
  // something the flow below it can be told about -- so such a page puts the
  // card in a grid column instead of floating it. The class is what switches
  // the layout; see the stylesheet. Mirrored in page.php.
  const hasPicture = Boolean(page.picture && page.picture.src);
%>
<section class="band">
  <%# The aside floats rather than taking a grid column, so the answers wrap
      beside it and then run the full width of the page once past it, instead of
      leaving a tall empty margin down the right. It has to come first in the
      source for a float to work, which does mean a screen reader meets the card
      before the copy -- it is four short lines, so that is the cheaper of the
      two costs. %>
  <div class="wrap page-flow<%= hasPicture ? ' has-picture' : '' %>">
    <%- include('partials/page-aside') %>
    <div class="prose">
      <%# A page can open its copy with a callout -- a `notice` object on the
          record, `{ heading, body }`, in the same panel the scholarships page
          uses for its enrolment instructions: the heading in bold with the body
          under it. Either half may be empty.

          It is the FIRST thing in the copy column, above the jump index, so its
          top edge lines up with the top of the aside card and the column starts
          on one horizontal. Mirrored in page.php. %>
      <% if (page.notice && (page.notice.heading || page.notice.body)) { %>
        <div class="notice page-notice">
          <div>
            <% if (page.notice.heading) { %><h3><%= page.notice.heading %></h3><% } %>
            <% if (page.notice.body) { %><p><%= page.notice.body %></p><% } %>
          </div>
        </div>
      <% } %>

      <% if (index.length) { %>
      <nav class="page-index" aria-label="On this page">
        <p class="eyebrow">On this page</p>
        <ol>
          <% index.forEach(function (heading) { %><li><a href="#<%= heading.id %>"><%- heading.html %></a></li><% }) %>
        </ol>
      </nav>
      <% } %>

      <%- article.html %>

      <%# A page with short copy leaves a gap under it. A page record can set
          `logoStrip: true` to fill it with the donor and partner marquee -- the
          same component the homepage uses, in its larger variant, and inline so
          it sits in this column directly under the last line of copy rather
          than as a band of its own below the section. Mirrored in page.php. %>
      <% if (page.logoStrip && typeof logos !== 'undefined' && logos.length) { %>
        <%- include('partials/logo-strip', { logos, stripSize: 'large', stripInline: true }) %>
      <% } %>

      <%# A page can carry the impact figures under its copy -- the same four
          panels the homepage band shows, from the same `site.impact`, so the
          numbers can never drift between the two. `.impact` is the ancestor the
          gold numerals are scoped to; `.impact-inline` drops the band's
          padding, border and watermark. Mirrored in page.php. %>
      <% if (page.impactFigures && site.impact && site.impact.length) { %>
        <div class="impact impact-inline">
          <%- include('partials/impact-figures', { impact: site.impact }) %>
        </div>
      <% } %>

      <%# A page can close its copy with a photograph. It sits INSIDE the prose
          column, directly under the last line of copy, the way the inline logo
          strip does -- and it ends level with the bottom of the aside card,
          which is why `.page-flow` takes `has-picture` above. Mirrored in
          page.php. %>
      <% if (hasPicture) { %>
        <%- include('partials/page-picture', { picture: page.picture }) %>
      <% } %>
    </div>
  </div>

</section>

<%
  // A page can carry a list of programs alongside its prose, the same way it can
  // carry a roster. Stored on the page record, so the admin page form still
  // edits the copy around it and leaves the list untouched. Mirrored in page.php.
  const programs = Array.isArray(page.programs) ? page.programs : [];
%>
<% if (programs.length) { %>
<section class="band tint" id="programs">
  <div class="wrap">
    <div class="program-list">
      <% programs.forEach(function (program, i) { %>
        <%- include('partials/program-section', { program, flip: i % 2 === 1 }) %>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%
  // Partners render as programs do -- a titled row with a photo and markdown --
  // so they share the one partial rather than duplicating it. Mirrored in page.php.
  const partners = Array.isArray(page.partners) ? page.partners : [];
  const gallery = Array.isArray(page.gallery) ? page.gallery : [];
%>
<% if (partners.length) { %>
<section class="band tint" id="partners">
  <div class="wrap">
    <div class="program-list">
      <% partners.forEach(function (partner, i) { %>
        <%- include('partials/program-section', { program: partner, flip: i % 2 === 1 }) %>
      <% }) %>
    </div>

    <% if (gallery.length) { %>
      <div class="gallery">
        <% gallery.forEach(function (shot) { %>
          <img src="<%= assetUrl(shot.src) %>" alt="<%= shot.alt %>" loading="lazy">
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
<% } %>

<%
  // A page can carry a roster of people alongside its prose -- the board is the
  // only one today. It is stored on the page record rather than as its own
  // content type, so the admin page form still edits the copy around it and
  // leaves the roster untouched. Mirrored in page.php.
  const members = Array.isArray(page.members) ? page.members : [];
%>
<% if (members.length) { %>
<%
  // The chief executive leads the page in a full-width row; everyone else keeps
  // the three-up grid. Driven by a lead flag on the record rather than by
  // position, so reordering the roster cannot silently promote someone.
  const leadIndex = members.findIndex(function (m) { return m.lead; });
  const lead = leadIndex === -1 ? null : members[leadIndex];
  const rest = members.filter(function (m, i) { return i !== leadIndex; });
%>
<section class="band tint" id="board">
  <div class="wrap">
    <h2 class="section-head">Board of Directors</h2>
    <% if (lead) { %>
      <%- include('partials/board-card', { member: lead, lead: true }) %>
    <% } %>
    <% if (rest.length) { %>
      <%# Unescaped on purpose: this interpolation builds an attribute, and the
          escaping form turns its quotes into entities, which yields a broken
          attribute and silently drops the rule in this build only. %>
      <div class="grid grid-3"<%- lead ? ' style="margin-top:28px"' : '' %>>
        <% rest.forEach(function (member) { %>
          <%- include('partials/board-card', { member, lead: false }) %>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
<% } %>

<%
  // Rendered from the site settings rather than the page body, so the address
  // block cannot drift from the footer and the admin only edits it once.
  const details = page.slug === 'contact'
    ? [['Email', site.email], ['Phone', site.phone], ['Location', site.location]]
        .filter(([, value]) => (value || '').trim())
    : [];
%>
<% if (details.length) { %>
<section class="band" style="padding-top:0">
  <div class="wrap">
    <dl class="contact-grid">
      <% details.forEach(function ([label, value]) { %>
        <div>
          <dt><%= label %></dt>
          <dd>
            <% if (label === 'Email') { %><a href="mailto:<%= value %>"><%= value %></a>
            <% } else if (label === 'Phone') { %><a href="tel:<%= value.replace(/[^0-9+]/g, '') %>"><%= value %></a>
            <% } else { %><%= value %><% } %>
          </dd>
        </div>
      <% }) %>
    </dl>
  </div>
</section>
<% } %>

<%- include('partials/page-cta') %>
<%- include('partials/foot') %>
