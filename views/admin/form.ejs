<%- include('../partials/admin-head') %>
<%
  const win = record.window || { type: 'inherit' };
  const value = (key) => { const v = getPath(record, key); return v === undefined || v === null ? '' : v; };
%>

<div class="admin-head">
  <div>
    <p class="small muted" style="margin:0"><a href="/admin/<%= name %>">← <%= config.plural %></a></p>
    <h1><%= isNew ? 'New ' + config.label.toLowerCase() : (record[config.titleKey] || config.label) %></h1>
  </div>
</div>

<% if (saved) { %><div class="saved">Saved. The public site is already showing this.</div><% } %>

<form method="post" action="/admin/<%= name %>/<%= isNew ? 'new' : record.id %>">
<div class="formgrid">
  <div class="panel">
    <% config.fields.forEach(function (field) { %>

      <% if (field.type === 'window') { %>
        <div class="field windowfield">
          <label class="title" for="window.type"><%= field.label %></label>
          <select id="window.type" name="window.type" data-window-type>
            <option value="inherit" <%= win.type === 'inherit' || !win.type ? 'selected' : '' %>>Use the site-wide enrollment period</option>
            <option value="annual" <%= win.type === 'annual' ? 'selected' : '' %>>Its own period, repeating every year</option>
            <option value="fixed" <%= win.type === 'fixed' ? 'selected' : '' %>>Its own one-off dates</option>
            <option value="always" <%= win.type === 'always' ? 'selected' : '' %>>Always accepting applications</option>
          </select>
          <% if (field.help) { %><div class="help"><%= field.help %></div><% } %>

          <div class="row2" data-window-block="annual" style="margin-top:14px">
            <div>
              <label class="title small" for="window.annualOpensOn">Opens (MM-DD)</label>
              <input type="text" id="window.annualOpensOn" name="window.annualOpensOn"
                     pattern="\d{2}-\d{2}" placeholder="11-01"
                     value="<%= win.type === 'annual' ? (win.opensOn || '') : '' %>">
            </div>
            <div>
              <label class="title small" for="window.annualClosesOn">Closes (MM-DD)</label>
              <input type="text" id="window.annualClosesOn" name="window.annualClosesOn"
                     pattern="\d{2}-\d{2}" placeholder="03-31"
                     value="<%= win.type === 'annual' ? (win.closesOn || '') : '' %>">
            </div>
            <p class="help" style="grid-column:1/-1;margin:0">
              A period that ends before it starts simply wraps the year — 11-01 to 03-31 is one cycle spanning two calendar years.
            </p>
          </div>

          <div class="row2" data-window-block="fixed" style="margin-top:14px">
            <div>
              <label class="title small" for="window.opensOn">Opens</label>
              <input type="date" id="window.opensOn" name="window.opensOn"
                     value="<%= win.type === 'fixed' ? (win.opensOn || '') : '' %>">
            </div>
            <div>
              <label class="title small" for="window.closesOn">Closes</label>
              <input type="date" id="window.closesOn" name="window.closesOn"
                     value="<%= win.type === 'fixed' ? (win.closesOn || '') : '' %>">
            </div>
          </div>
        </div>

      <% } else if (field.type === 'checkbox') { %>
        <div class="field check">
          <input type="checkbox" id="<%= field.key %>" name="<%= field.key %>" <%= value(field.key) ? 'checked' : '' %>>
          <label class="title" for="<%= field.key %>"><%= field.label %></label>
        </div>

      <% } else if (field.type === 'textarea' || field.type === 'markdown' || field.type === 'lines') { %>
        <div class="field">
          <label class="title" for="<%= field.key %>"><%= field.label %></label>
          <textarea id="<%= field.key %>" name="<%= field.key %>"
                    rows="<%= field.rows || (field.type === 'markdown' ? 10 : 4) %>"
                    class="<%= field.type === 'markdown' ? 'mono' : '' %>"><%= field.type === 'lines' ? (value(field.key) || []).join('\n') : value(field.key) %></textarea>
          <% if (field.help) { %><div class="help"><%= field.help %></div><% } %>
        </div>

      <% } else if (field.type === 'select') { %>
        <div class="field">
          <label class="title" for="<%= field.key %>"><%= field.label %></label>
          <select id="<%= field.key %>" name="<%= field.key %>">
            <% field.options.forEach(function (option) { %>
              <option value="<%= option.value %>" <%= String(value(field.key)) === option.value ? 'selected' : '' %>><%= option.label %></option>
            <% }) %>
          </select>
          <% if (field.help) { %><div class="help"><%= field.help %></div><% } %>
        </div>

      <% } else if (field.type === 'scholarship') { %>
        <div class="field">
          <label class="title" for="<%= field.key %>"><%= field.label %></label>
          <input type="text" id="<%= field.key %>" name="<%= field.key %>" list="scholarship-names" value="<%= value(field.key) %>">
          <datalist id="scholarship-names">
            <% scholarshipNames.forEach(function (option) { %><option value="<%= option %>"></option><% }) %>
          </datalist>
          <div class="help">Match the scholarship name exactly and this recipient appears on that scholarship's page.</div>
        </div>

      <% } else { %>
        <div class="field">
          <label class="title" for="<%= field.key %>"><%= field.label %></label>
          <input type="<%= field.type === 'number' ? 'number' : (field.type === 'date' ? 'date' : 'text') %>"
                 id="<%= field.key %>" name="<%= field.key %>"
                 value="<%= value(field.key) %>"
                 placeholder="<%= field.placeholder || '' %>"
                 <%= field.required ? 'required' : '' %>>
          <% if (field.help) { %><div class="help"><%= field.help %></div><% } %>
        </div>
      <% } %>

    <% }) %>
  </div>

  <aside class="sticky">
    <div class="panel">
      <button class="btn btn-ink" type="submit" style="width:100%">Save <%= config.label.toLowerCase() %></button>
      <% if (!isNew && name === 'scholarships' && record.slug) { %>
        <a class="btn btn-outline btn-sm" style="width:100%;text-align:center;margin-top:10px" href="/scholarships/<%= record.slug %>?preview=1">Preview page</a>
      <% } %>
      <% if (!isNew && name === 'pages' && record.slug) { %>
        <a class="btn btn-outline btn-sm" style="width:100%;text-align:center;margin-top:10px" href="/<%= record.slug %>?preview=1">Preview page</a>
      <% } %>
    </div>

    <% if (name === 'scholarships') { %>
      <div class="panel">
        <h2>Right now</h2>
        <p class="small muted">Based on today, <%= schedule.formatDate(today) %>.</p>
        <%
          const resolved = schedule.resolveWindow(
            (!win.type || win.type === 'inherit') ? enrollmentSettings : win, today
          );
        %>
        <p style="margin-bottom:.4em">
          <span class="tag <%= resolved.state === 'open' ? 'tag-open' : 'tag-shut' %>"><%= resolved.state %></span>
        </p>
        <p class="small" style="margin:0"><%= schedule.describeWindow(resolved) %>.</p>
      </div>
    <% } %>

    <% if (!isNew) { %>
      <div class="panel">
        <h2>Delete</h2>
        <p class="small muted">This cannot be undone.</p>
        <form method="post" action="/admin/<%= name %>/<%= record.id %>/delete"
              onsubmit="return confirm('Delete this <%= config.label.toLowerCase() %>?')">
          <button class="btn btn-sm btn-outline" type="submit" style="width:100%">Delete <%= config.label.toLowerCase() %></button>
        </form>
      </div>
    <% } %>
  </aside>
</div>
</form>

<script src="/js/admin.js"></script>
<%- include('../partials/admin-foot') %>
