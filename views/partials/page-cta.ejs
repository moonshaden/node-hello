<%#
  Closing call to action, shared by every content page.

  Driven by the enrollment window rather than written per page, so it stays
  right in November without anybody editing it. The giving page gets the
  donor-facing variant; everything else points at the scholarships.
%>
<% const isDonate = locals.page && page.slug === 'donate'; %>
<% const isOpen = enrollment.state === 'open'; %>
<section class="band tint">
  <div class="wrap">
    <div class="cta-panel">
      <div>
        <% if (isDonate) { %>
          <p class="eyebrow">Every gift is a door</p>
          <h2>Ready to support a student?</h2>
          <p>Gifts are tax deductible, and we will help you set up a named or memorial award.</p>
        <% } else { %>
          <p class="eyebrow"><%= isOpen ? 'Applications are open' : 'Plan ahead' %></p>
          <h2><%= isOpen ? 'Apply for every award you qualify for.' : 'Be ready when applications reopen.' %></h2>
          <p>
            <% if (isOpen) { %>
              The enrollment period closes <%= schedule.formatDate(enrollment.closesOn) %>.
            <% } else { %>
              Applications reopen <%= schedule.formatDate(enrollment.opensOn) %>. Review the criteria now so nothing is a surprise.
            <% } %>
          </p>
        <% } %>
      </div>
      <div class="actions">
        <% if (isDonate && site.donateUrl) { %>
          <a class="btn btn-gold" href="<%= site.donateUrl %>">Donate now</a>
          <a class="btn btn-outline" style="color:#fff" href="/contact">Talk to us first</a>
        <% } else { %>
          <a class="btn btn-gold" href="/scholarships"><%= isOpen ? 'Apply for a scholarship' : 'See available scholarships' %></a>
          <a class="btn btn-outline" style="color:#fff" href="/recipients">Meet our recipients</a>
        <% } %>
      </div>
    </div>
  </div>
</section>
