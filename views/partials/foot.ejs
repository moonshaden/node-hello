</main>

<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <img class="foot-mark" src="/img/brand/leo-mark-lion.png"
             alt="" aria-hidden="true" width="520" height="380" loading="lazy">
        <%# The wordmark below is the accessible name of the pair, so the mark
            above it is decorative -- otherwise both announce the same thing. %>
        <img class="foot-lockup" src="/img/brand/leo-lockup-footer.png"
             alt="<%= site.name %> — <%= site.tagline %>"
             width="679" height="146" loading="lazy">
        <p class="small"><%= site.mission %></p>
      </div>
      <div>
        <h4>Scholarships</h4>
        <ul>
          <li><a href="/scholarships">Available scholarships</a></li>
          <li><a href="/recipients">Scholarship recipients</a></li>
          <%# Flattened, so a page nested under a dropdown still appears here. %>
          <% navFlat.forEach(function (p) { %>
            <li><a href="/<%= p.slug %>"><%= p.navLabel || p.title %></a></li>
          <% }) %>
        </ul>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          <% if (site.email) { %><li><a href="mailto:<%= site.email %>"><%= site.email %></a></li><% } %>
          <% if (site.phone) { %><li><a href="tel:<%= site.phone.replace(/[^0-9+]/g, '') %>"><%= site.phone %></a></li><% } %>
          <% if (site.location) { %><li><%= site.location %></li><% } %>
          <% if (site.facebookUrl) { %><li><a href="<%= site.facebookUrl %>">Facebook</a></li><% } %>
        </ul>

        <%# Legal sits under Contact rather than in its own column: it is one or
            two links and a fourth column would leave the row lopsided. The list
            is whatever pages carry `legal: true`, so a terms of service appears
            here the moment one is written, with no change to this file. %>
        <% if (legalPages.length) { %>
          <h4 class="foot-legal-head">Legal</h4>
          <ul>
            <% legalPages.forEach(function (p) { %>
              <li><a href="/<%= p.slug %>"><%= p.navLabel || p.title %></a></li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>
    <div class="foot-legal">
      <%= site.legalName || site.name %> is a 501(c)(3) nonprofit organization<% if (site.ein) { %>, EIN <%= site.ein %><% } %>.
      Contributions are tax deductible to the extent allowed by law.
      <a href="/admin" style="float:right">Staff sign in</a>
    </div>
  </div>
</footer>

<script src="<%= assetUrl('/js/site.js') %>" defer></script>

</body>
</html>
