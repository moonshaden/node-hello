<article class="card recipient">
  <% if (recipient.photoUrl) { %>
    <img class="portrait" src="<%= recipient.photoUrl %>" alt="<%= recipient.name %>" loading="lazy" width="800" height="1000">
  <% } else { %>
    <div class="portrait portrait-fallback"><%= (recipient.name || '?').trim().charAt(0).toUpperCase() %></div>
  <% } %>
  <h3 class="name"><%= recipient.name %><% if (preview && recipient.draft) { %> <span class="pill pill-closed">Draft</span><% } %></h3>
  <div class="award"><%= recipient.scholarship %><% if (recipient.amount) { %> · <%= formatMoney(recipient.amount) %><% } %></div>
  <div class="meta">
    <%= [recipient.major, recipient.school].filter(Boolean).join(' · ') %>
    <% if (recipient.year) { %><br>Class of <%= recipient.year %><% } %>
  </div>
  <% if (recipient.quote) { %>
    <% const story = excerpt(recipient.quote); %>
    <% if (story.truncated) { %>
      <details class="story">
        <summary>
          <blockquote class="story-excerpt"><%= story.text %></blockquote>
          <span class="story-toggle"><span class="when-shut">Read the full story</span><span class="when-open">Show less</span></span>
        </summary>
        <blockquote class="story-full"><%= story.full %></blockquote>
      </details>
    <% } else { %>
      <blockquote><%= story.text %></blockquote>
    <% } %>
  <% } %>
</article>
